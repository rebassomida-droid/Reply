# ───────────────────────────────────────────────
# Housetag Voice AI — Variabili d'ambiente
# Copia questo file in .env e compila i valori
# ───────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Autenticazione pannello
ADMIN_PASSWORD=housetag2024
JWT_SECRET=cambia-questo-valore-in-produzione

# Database PostgreSQL + pgvector
DATABASE_URL=postgresql://reply_user:reply_pass@localhost:5432/reply_voice

# Anthropic Claude AI
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embedding documenti)
OPENAI_API_KEY=sk-...

# Vapi.ai (agente vocale)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
BACKEND_URL=https://tuodominio.com

# ─── WhatsApp ───────────────────────────────────
# Scegli il provider: twilio | meta
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta WhatsApp Cloud API (alternativa a Twilio)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
